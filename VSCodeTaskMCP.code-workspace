{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "files.eol": "\n",
    "files.exclude": {
      "node_modules/": true,
      "package-lock.json": true,
      "LICENSE": true,
      "dist/": true,
      "out/": true
    },
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    },
    "typescript.tsdk": "node_modules/typescript/lib"
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Run Extension",
        "type": "extensionHost",
        "request": "launch",
        "args": ["--extensionDevelopmentPath=."],
        "outFiles": ["./dist/**/*.js"],
        "preLaunchTask": "build"
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "build",
        "type": "npm",
        "script": "build",
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": ["$esbuild"]
      },
      {
        "label": "watch",
        "type": "npm",
        "script": "watch",
        "isBackground": true,
        "group": "build",
        "problemMatcher": ["$esbuild-watch"]
      }
    ]
  }
}
